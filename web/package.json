{
  "name": "attune-web",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "concurrently": "^10.0.3",
    "svelte": "^5.56.4",
    "vite": "^8.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync-verovio": "node scripts/sync-verovio.mjs",
    "sync-icons": "node scripts/sync-icons.mjs",
    "sync-synth": "node scripts/sync-synth.mjs",
    "build:deploy": "npm run sync-verovio && npm run sync-icons && npm run sync-synth && vite build",
    "backend": "cd .. && venv/bin/uvicorn web.api.analyze_api:app --app-dir . --port 8000",
    "dev:all": "concurrently -n backend,frontend -c blue,green \"npm run backend\" \"npm run dev\""
  },
  "dependencies": {
    "js-synthesizer": "^1.13.0"
  }
}
